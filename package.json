{
  "name": "skill-workbench",
  "productName": "Skill 管理工作台",
  "version": "0.2.0",
  "description": "跨 Codex、Claude 与 WorkBuddy 的本地 Skill 管理工作台",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "build": "electron-forge package",
    "make": "electron-forge make --platform=win32 --arch=x64 && node scripts/make-squirrel.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:installer-startup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-installer-startup.ps1",
    "benchmark:scan": "node scripts/benchmark-local-scan.mjs",
    "smoke:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:installer-startup && npm run test:e2e"
  },
  "author": "暴论哥3.0（公众号同名）",
  "license": "UNLICENSED",
  "config": {
    "forge": "./forge.config.js"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@uiw/react-codemirror": "^4.25.11",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.2",
    "electron-squirrel-startup": "^1.0.1",
    "fast-glob": "^3.3.3",
    "i18next": "^26.3.6",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-webpack": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/webpack-asset-relocator-loader": "^1.10.2",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "css-loader": "^7.1.4",
    "electron": "^43.4.0",
    "electron-winstaller": "^5.4.4",
    "node-loader": "^2.1.0",
    "postcss": "^8.5.26",
    "postcss-loader": "^8.2.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.17",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  }
}
